; EmbedForge bootstrap installer for Windows 10 22H2 / 11 x86-64 (SS-01).
; Built by packaging/windows/build-nsis.sh from a signed staging tree:
;   makensis -DVERSION=<v> -DSTAGE=<stage dir> -DOUTFILE=<exe> embedforge.nsi
; The installer runs from the installation medium and needs no network (INV-10).
Unicode true
SetCompressor /SOLID lzma
RequestExecutionLevel user          ; MultiUser raises it only for an all-users install (SS-05)

!ifndef VERSION
  !error "VERSION not defined"
!endif
!ifndef STAGE
  !error "STAGE not defined"
!endif
!ifndef OUTFILE
  !define OUTFILE "EmbedForge-Setup-${VERSION}.exe"
!endif

!define MULTIUSER_EXECUTIONLEVEL Highest
!define MULTIUSER_MUI
!define MULTIUSER_INSTALLMODE_COMMANDLINE
!define MULTIUSER_INSTALLMODE_INSTDIR "EmbedForge"
!define MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_KEY "Software\EmbedForge"
!define MULTIUSER_INSTALLMODE_DEFAULT_REGISTRY_VALUENAME "InstallMode"
!define MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_KEY "Software\EmbedForge"
!define MULTIUSER_INSTALLMODE_INSTDIR_REGISTRY_VALUENAME "InstallDir"
!include MultiUser.nsh
!include MUI2.nsh
!include LogicLib.nsh

Name "EmbedForge ${VERSION}"
OutFile "${OUTFILE}"
BrandingText "EmbedForge ${VERSION}"
Var With   ; comma-separated optional packs chosen on the components page

!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_LICENSE "${STAGE}\LICENSE.txt"
; SS-02: the WebView2 runtime licence terms are presented for acceptance. The release
; pipeline supplies the text (webview2-terms.txt); build-nsis.sh refuses a placeholder.
!insertmacro MUI_PAGE_LICENSE "webview2-terms.txt"
!insertmacro MULTIUSER_PAGE_INSTALLMODE
!define MUI_PAGE_CUSTOMFUNCTION_SHOW ShowPerUserNote
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Function .onInit
  !insertmacro MULTIUSER_INIT
  StrCpy $With ""
FunctionEnd
Function un.onInit
  !insertmacro MULTIUSER_UNINIT
FunctionEnd

; SS-05: without administrator rights there is no helper and no driver installation.
Function ShowPerUserNote
  ${If} $MultiUser.InstallMode == "CurrentUser"
    MessageBox MB_ICONINFORMATION "Installing for this user only (no administrator rights).$\r$\n$\r$\nNot available in this mode:$\r$\n - writing Raspberry Pi OS images to SD cards$\r$\n - the EmbedForge project service on the PC$\r$\n$\r$\nEverything else works. Install for all users later to add them."
  ${EndIf}
FunctionEnd

Section "EmbedForge (required)" SecCore
  SectionIn RO
  SetOutPath "$INSTDIR"
  File /r "${STAGE}\*.*"
  ; WebView2 runtime (offline standalone installer from the medium) when it is missing
  ReadRegStr $0 HKLM "SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
  ${If} $0 == ""
    ReadRegStr $0 HKCU "Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
  ${EndIf}
  ${If} $0 == ""
  ${AndIf} ${FileExists} "$EXEDIR\redist\MicrosoftEdgeWebView2RuntimeInstallerX64.exe"
    DetailPrint "Installing the WebView2 runtime from the medium…"
    ExecWait '"$EXEDIR\redist\MicrosoftEdgeWebView2RuntimeInstallerX64.exe" /silent /install' $1
    ${If} $1 != 0
      MessageBox MB_ICONSTOP "The WebView2 runtime could not be installed (code $1)."
      Abort
    ${EndIf}
  ${EndIf}
  WriteUninstaller "$INSTDIR\uninstall.exe"
  CreateShortCut "$SMPROGRAMS\EmbedForge.lnk" "$INSTDIR\embedforge.exe"
  WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\EmbedForge" "DisplayName" "EmbedForge"
  WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\EmbedForge" "DisplayVersion" "${VERSION}"
  WriteRegStr SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\EmbedForge" "UninstallString" '"$INSTDIR\uninstall.exe" /$MultiUser.InstallMode'
  WriteRegStr SHCTX "Software\EmbedForge" "InstallDir" "$INSTDIR"
SectionEnd

; Optional packs from medium-spec.json, generated by build-nsis.sh (SS-01: selectable at
; installation, with the consequence of leaving each out in its description).
!include "optional-packs.nsh"

Section "-Component packs" SecPacks
  DetailPrint "Installing component packs from the medium (offline)…"
  nsExec::ExecToLog '"$INSTDIR\ef-bootstrap.exe" --medium "$EXEDIR" --root "$INSTDIR" --with "$With"'
  Pop $0
  ${If} $0 != 0
    MessageBox MB_ICONSTOP "Component installation stopped (code $0). Details: $INSTDIR\state\install-events.jsonl. Run the installer again to resume."
    Abort
  ${EndIf}
SectionEnd

Section "Uninstall"
  Delete "$SMPROGRAMS\EmbedForge.lnk"
  DeleteRegKey SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\EmbedForge"
  DeleteRegKey SHCTX "Software\EmbedForge"
  ; the app's own directory only; per-user projects and settings are kept
  RMDir /r "$INSTDIR"
SectionEnd
