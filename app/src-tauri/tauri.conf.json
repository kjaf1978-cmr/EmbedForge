{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmbedForge",
  "version": "0.1.0",
  "identifier": "org.embedforge.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [{ "title": "EmbedForge", "width": 1600, "height": 900, "minWidth": 1024, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
